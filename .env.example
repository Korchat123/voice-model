# Copy this file to .env and adjust local, non-secret settings.
VOICE_MODEL_ENV=development
VOICE_MODEL_HOST=127.0.0.1
VOICE_MODEL_PORT=8765
VOICE_MODEL_LOG_LEVEL=INFO
VOICE_MODEL_ENGINE=fake
VOICE_MODEL_ID=local-assistant
VOICE_MODEL_VERSION=0.1.0-dev
VOICE_MODEL_SAMPLE_RATE=24000
VOICE_MODEL_ENCODING=pcm_s16le
VOICE_MODEL_MAX_TEXT_LENGTH=2000
VOICE_MODEL_MAX_OUTPUT_SECONDS=120
VOICE_MODEL_MAX_CONCURRENCY=1
VOICE_MODEL_REQUEST_TIMEOUT_SECONDS=180
VOICE_MODEL_DATA_DIR=./data
VOICE_MODEL_MODELS_DIR=./models
VOICE_MODEL_RUNS_DIR=./runs
